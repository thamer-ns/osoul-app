# انسخ هذا الملف إلى .env محليًا فقط، ولا ترفعه إلى Git.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
AUTH_SECRET=ضع_سراً_عشوائياً_بطول_32_حرفاً_على_الأقل

# تجمع PostgreSQL الآمن للخيوط. اضبطه بحسب حد اتصالات قاعدة البيانات.
OSOUL_DB_POOL_MIN=1
OSOUL_DB_POOL_MAX=10

# مصادر الأسعار والشموع. Twelve Data قائم، والبقية بدائل رسمية اختيارية.
TWELVEDATA_API_KEY=
FMP_API_KEY=
EODHD_API_KEY=
ALPHAVANTAGE_API_KEY=
MARKET_DATA_PROVIDER_ORDER=twelvedata,fmp,eodhd,alphavantage
FINANCIAL_DATA_PROVIDER_ORDER=fmp,eodhd,alphavantage

# حدود الأداء التفاعلي والتخزين المؤقت.
OSOUL_HISTORY_INTERACTIVE_BUDGET_SECONDS=6
OSOUL_QUOTE_INTERACTIVE_BUDGET_SECONDS=3
OSOUL_FINANCIAL_INTERACTIVE_BUDGET_SECONDS=3
OSOUL_PROVIDER_REQUEST_TIMEOUT_SECONDS=3
OSOUL_HISTORY_INTRADAY_TTL_SECONDS=120
OSOUL_HISTORY_DAILY_TTL_SECONDS=1200
OSOUL_HISTORY_HIGHER_TTL_SECONDS=10800
OSOUL_QUOTE_TTL_SECONDS=90
OSOUL_FINANCIAL_TTL_SECONDS=21600
OSOUL_IO_WORKERS=4
OSOUL_IO_MAX_INFLIGHT=10

# خدمة بوت السوق المستقلة. لا تضع Telegram Bot Token في أصولي.
# استخدم HTTPS في الإنتاج. HTTP مسموح تلقائيًا لـ localhost فقط.
SC_BOT_BASE_URL=
OSOUL_ALLOW_INSECURE_BOT_HTTP=0
# عقد المزامنة الجديد: يطابق OSOLI_SYNC_TOKEN في خدمة البوت.
SC_BOT_SYNC_TOKEN=
# سر محلي عشوائي بطول 32 حرفًا على الأقل لاشتقاق Channel منفصل لكل محفظة.
SC_BOT_SYNC_SECRET=
# توافق خلفي للإرسال القديم فقط؛ لا يلزم عند تفعيل المزامنة الجديدة.
SC_BOT_TRADINGVIEW_TOKEN=

# سياسة كلمات المرور والجلسات — الأسماء مطابقة فعليًا للكود.
OSOUL_MIN_PASSWORD_LEN=10
OSOUL_SESSION_IDLE_MINUTES=120
OSOUL_MAX_LOGIN_ATTEMPTS=5
OSOUL_LOGIN_LOCK_SECONDS=900

# الإنتاج: لا تستخدم SQLite عند تعطل PostgreSQL.
OSOUL_REQUIRE_DB=1
OSOUL_ALLOW_SQLITE_FALLBACK=0
