# انسخ هذا الملف إلى .env وضع القيم المناسبة (لا ترفعه إلى Git)

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
AUTH_SECRET=ضع_سراً_قوياً_هنا
TWELVEDATA_API_KEY=YOUR_API_KEY

# سياسة كلمات المرور
MIN_PASSWORD_LEN=8
ALLOW_LEGACY_PIN=1
REQUIRE_LETTER_DIGIT=0

# مهلة الجلسة (بالدقائق)
SESSION_IDLE_MINUTES=60
